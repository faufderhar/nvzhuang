# AI 换装后端环境变量配置示例
# 复制为 .env 文件后填入对应模型的 Key：
# cp .env.example .env

# OpenAI GPT-Image-2 (官方生图模型)
OPENAI_API_KEY=sk-xxxx

# 豆包 Seedream (火山方舟，国内免翻墙首选)
ARK_API_KEY=xxxx

# Google Gemini (Nano Banana 2)
GEMINI_API_KEY=AIzaSyxxxx

# 通义万相 / 阿里百炼
DASHSCOPE_API_KEY=sk-xxxx

# 后端访问鉴权 Token（32~512 个字符，多个以英文逗号分隔；当 security.authRequired: true 时必须配置）
# 必须使用随机值生成，例如：openssl rand -hex 32
# 后端会拒绝示例/占位值（含 your-、example、placeholder 等片段或字符种类过少）并拒绝启动。
TRYON_API_KEYS=
